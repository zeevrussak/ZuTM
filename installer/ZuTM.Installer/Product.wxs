<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZuTM (c) Ze'ev Russak <zutm@20032014.xyz> — Apache License 2.0.
  MSI package: per-machine install, major upgrades in place, clean uninstall.
  Built per-architecture by scripts/build-installer.ps1:
    ZuTM-x64.msi / ZuTM-arm64.msi   (asset names matched by the update client)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="ZuTM"
      Manufacturer="Ze'ev Russak"
      Version="$(var.Version)"
      UpgradeCode="7C2B36B0-9E1F-4D9A-92A4-1E9F0C4D2A11"
      Language="1033"
      Codepage="1252"
      Scope="perMachine">

    <SummaryInformation
        Description="ZuTM — Virtual machines for Windows (UTM-compatible). Installer and updates © 2026 Ze'ev Russak."
        Manufacturer="Ze'ev Russak" />

    <!-- Major upgrade: replaces any older ZuTM in one pass (online updates rely on this). -->
    <MajorUpgrade
        AllowDowngrades="no"
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of ZuTM is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Automatic install logging: every msiexec run of this package writes
         %TEMP%\MSI*.log, so a failed or cancelled install is diagnosable
         instead of a wizard that just went away. '!' flushes each line, so
         even a hard crash mid-install leaves the trail. -->
    <Property Id="MsiLogging" Value="voicewarmupx!" />

    <!-- Interactive setup wizard (Welcome → install location → install →
         finish). Without it double-clicking the MSI runs with no visible
         wizard, which reads as "the installer does nothing". -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- Icon: Add/Remove Programs entry and Start-menu shortcut. -->
    <Property Id="ARPNOREPAIR" Value="0" />
    <Property Id="ARPHELPLINK" Value="https://github.com/zeevrussak/ZuTM" />
    <Property Id="ARPPRODUCTICON" Value="ZutmIcon" />
    <Icon Id="ZutmIcon" SourceFile="..\..\src\ZuTM.App\Assets\app.ico" />

    <Launch Condition="Installed OR (VersionNT &gt;= 602)" Message="ZuTM requires Windows 11 or later." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ZuTM" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ZuTM" />
    </StandardDirectory>

    <Feature Id="Main" Title="ZuTM" Level="1" AllowAbsent="no">
      <Feature Id="Application" Title="ZuTM application" Level="1">
        <ComponentGroupRef Id="ProductComponents" />
      </Feature>
      <Feature Id="Shortcuts" Title="Start menu shortcut" Level="1">
        <ComponentRef Id="ApplicationShortcut" />
      </Feature>
    </Feature>

    <!-- App core: the published, self-contained WinUI app, harvested by
         scripts/build-installer.ps1 (wix heat → Harvest.wxs, group
         HarvestedComponents). Building the MSI therefore goes through the
         script or CI, which run publish + heat first. -->
    <ComponentGroup Id="ProductComponents">
      <ComponentGroupRef Id="HarvestedComponents" />
    </ComponentGroup>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="8D0C58B2-4D3F-49F0-9F84-0D6F2E9A5C21">
        <Shortcut
            Id="ZutmStartMenuShortcut"
            Name="ZuTM"
            Description="Virtual machines for Windows — ZuTM (c) Ze'ev Russak"
            Target="[INSTALLFOLDER]ZuTM.exe"
            Icon="ZutmIcon"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <!-- Key path is per-machine: an HKCU key path would make this
             component's installed state depend on which user happened to run
             the install, so an upgrade under another account (or elevation)
             could leave the shortcut removed and never recreated. -->
        <RegistryValue Root="HKLM" Key="Software\ZuTM" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Package>
</Wix>
