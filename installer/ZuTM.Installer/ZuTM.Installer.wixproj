<Project Sdk="WixToolset.Sdk/6.0.2">

  <!-- ZuTM (c) Ze'ev Russak <zutm@20032014.xyz> — ZuTM Attribution License.
       Requires -p:PublishDir to point at the dotnet publish output (see
       scripts/build-installer.ps1). Heat harvests that folder into the
       HarvestedComponents group inside INSTALLFOLDER. -->

  <PropertyGroup>
    <OutputName>ZuTM-$(Platform)</OutputName>
    <InstallerVersion Condition="'$(InstallerVersion)' == ''">0.1.0</InstallerVersion>
    <DefineConstants>Version=$(InstallerVersion);PublishDir=$(PublishDir)</DefineConstants>
    <!-- HEAT5149 (heat deprecation notice on the v6 line) is informational. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- QEMU locale files carry non-MSI language ids; ICE03's column format
         check flags them even though the data is inert. -->
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" />
    <HarvestDirectory Include="$(PublishDir)">
      <ComponentGroupName>HarvestedComponents</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <PreprocessorVariable>var.PublishDir</PreprocessorVariable>
      <GenerateGuidsNow>true</GenerateGuidsNow>
    </HarvestDirectory>
  </ItemGroup>

</Project>
