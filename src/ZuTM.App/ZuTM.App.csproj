<Project Sdk="Microsoft.NET.Sdk">

  <!-- ZuTM (c) Ze'ev Russak <zutm@20032014.xyz> — ZuTM Attribution License -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>ZuTM.App</RootNamespace>
    <AssemblyName>ZuTM</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>

    <!-- MSI deployment: unpackaged app, self-contained Windows App SDK runtime -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>

    <!-- WinUI code-gen analyzers are chatty; keep them informational in the UI project. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <Description>ZuTM — virtual machines for Windows, compatible with UTM.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZuTM.Core\ZuTM.Core.csproj" />
    <ProjectReference Include="..\ZuTM.Spice\ZuTM.Spice.csproj" />
    <ProjectReference Include="..\ZuTM.Update\ZuTM.Update.csproj" />
  </ItemGroup>

</Project>
