  UTM-style layout: left VM list, right detail pane; native WinUI 3 Fluent look
  (Mica backdrop, system accent, light/dark follows Windows).
-->
<Window
    x:Class="ZuTM.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ZuTM.App"
    xmlns:vm="using:ZuTM.App.ViewModels"
    xmlns:svc="using:ZuTM.App.Services"
    mc:Ignorable="d">

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title / command bar -->
    <Grid Grid.Row="0" Padding="12,8,12,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE9B9;" FontSize="18" />
        <TextBlock Text="ZuTM" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Content="New VM" Style="{StaticResource AccentButtonStyle}" Click="OnNewVmClick" ToolTipService.ToolTip="Create a virtual machine" />
        <Button Content="Refresh" Click="OnRefreshClick" ToolTipService.ToolTip="Rescan the VM folder" />
        <Button Content="Settings" Click="OnSettingsClick" />
      </StackPanel>
    </Grid>

    <!-- List + detail split -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="260" MaxWidth="480" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
            Grid.Row="0"
            ItemsSource="{x:Bind ViewModel.VirtualMachines, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedVm, Mode=TwoWay}"
            SelectionMode="Single"
            DoubleTapped="OnVmDoubleTapped">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="svc:VmItemViewModel">
              <Grid ColumnSpacing="12" Padding="4,8,4,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <InfoBadge Grid.Column="2" Visibility="{x:Bind local:Converters.ToVisibility(HasError), Mode=OneWay}" ToolTipService.ToolTip="This VM reported an error (see the detail pane)" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="1" Padding="12,6" Background="{ThemeResource LayerFillColorAltBrush}">
          <TextBlock
              x:Name="VmFolderText"
              Style="{StaticResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              TextTrimming="CharacterEllipsis" />
        </Border>
      </Grid>

      <!-- Detail -->
      <ScrollViewer Grid.Column="1" Padding="24,8,24,8">
        <StackPanel Spacing="8">
          <local:VmDetailView x:Name="DetailView" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Padding="12,6" Background="{ThemeResource LayerFillColorAltBrush}">
      <TextBlock
          x:Name="StatusBarText"
          Style="{StaticResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Border>
  </Grid>
</Window>
