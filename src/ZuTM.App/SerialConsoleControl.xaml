<UserControl
    x:Class="ZuTM.App.SerialConsoleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <Grid RowSpacing="6" MinHeight="180">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <Button x:Name="ConnectButton" Content="Attach" Click="OnAttachClick"
              AutomationProperties.AutomationId="SerialAttachButton"
              ToolTipService.ToolTip="Attach to this VM's serial console (TCP endpoint)" />
      <Button x:Name="DetachButton" Content="Detach" Click="OnDetachClick" IsEnabled="False"
              AutomationProperties.AutomationId="SerialDetachButton" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Not attached" />
    </StackPanel>

    <TextBox Grid.Row="1" x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
             AcceptsReturn="True" PlaceholderText="Serial console output appears here…"
             AutomationProperties.AutomationId="SerialOutput" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
      <TextBox x:Name="Input" MinWidth="360" KeyDown="OnInputKeyDown" PlaceholderText="Type a command and press Enter"
               AutomationProperties.AutomationId="SerialInput" />
      <Button Content="Send" Click="OnSendClick" AutomationProperties.AutomationId="SerialSendButton" />
    </StackPanel>
  </Grid>
</UserControl>
