<ContentDialog
    x:Class="ZuTM.App.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

  <StackPanel Spacing="12" MinWidth="460">
    <TextBox x:Name="VmFolderBox" Header="Virtual machines folder" />

    <StackPanel Spacing="4">
      <TextBox x:Name="DownloadsFolderBox"
               Header="Downloads folder — downloaded installer ISOs land here (empty = inside each VM's bundle)" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Browse…" Click="OnBrowseDownloadsFolderClick"
                AutomationProperties.AutomationId="DownloadsFolderBrowseButton"
                ToolTipService.ToolTip="Pick a folder on a roomy drive; the ISO stays there and VMs reference it" />
        <Button Content="Open folder" Click="OnOpenDownloadsFolderClick"
                AutomationProperties.AutomationId="DownloadsFolderOpenButton"
                ToolTipService.ToolTip="Open the configured downloads folder (or the VM folder when unset)" />
      </StackPanel>
      <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                 Text="A custom folder keeps one download reusable by several VMs; bundles then reference the ISO instead of carrying it." />
    </StackPanel>

    <CheckBox x:Name="UpdateCheckBox" Content="Check for updates weekly (GitHub Releases)" IsChecked="True" />

    <!-- Updates -->
    <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Check now" Click="OnCheckUpdatesClick" />
      <ProgressRing x:Name="UpdateProgress" IsActive="False" Width="20" Height="20" Visibility="Collapsed" />
    </StackPanel>
    <InfoBar x:Name="UpdateInfoBar" IsOpen="False" />

    <!-- About -->
    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
    <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
               Text="ZuTM — virtual machines for Windows, compatible with UTM bundles.&#x0a;© 2026 Ze'ev Russak &lt;zutm@20032014.xyz&gt;.&#x0a;ZuTM Attribution License — copies must credit the author. Inspired by UTM (© osy, Apache-2.0); QEMU (GPLv2) and SPICE/virt-viewer (GPLv2+) ship as separate programs." />
  </StackPanel>
</ContentDialog>
